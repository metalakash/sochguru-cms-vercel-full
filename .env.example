# Server-only key used by app/api/generate-content/route.js — do NOT prefix
# with NEXT_PUBLIC_, it must never be exposed to the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=

# Server-only token used by app/api/publish/route.js for Meta Graph API access.
# Get a long-lived token via Meta's developer dashboard.
META_ACCESS_TOKEN=
