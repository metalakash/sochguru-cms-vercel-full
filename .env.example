# ---------------------------------------------------------------------------
# Access gate
# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED for any public deployment. Every route below spends money
# on your accounts, and /api/publish posts to your Facebook Page. With no code
# set the app is completely open to anyone who finds the URL.
# Set this to a long random string, then share it with whoever should have access.
CMS_ACCESS_CODE=

# ---------------------------------------------------------------------------
# Gemini — content generation
# ---------------------------------------------------------------------------
# Visitors bring their OWN Gemini key, entered in the app and held in their
# browser. Nothing here is needed for that to work.
#
# SOCHGURUCMSMAIN below is the operator's key. It is released ONLY to visitors
# who entered CMS_ACCESS_CODE, so your invite list generates without bringing
# a key and you pay for them. Anonymous callers never reach it.
#
# Set it ONLY together with CMS_ACCESS_CODE. A server key on an ungated
# instance is an open endpoint that anyone who finds the URL can bill to you.
# This app shipped exactly that for 19 days — do not recreate it.
# This exact name is the only one read — there is deliberately no alias.
SOCHGURUCMSMAIN=

# Optional. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Meta — Facebook Page publishing
# ---------------------------------------------------------------------------
# Server-only token. Get a long-lived token via Meta's developer dashboard.
META_ACCESS_TOKEN=

# The Page every post goes to. When set, this wins over whatever the browser
# sends, so a caller cannot aim your token at another Page the token can reach.
# Leave unset only for local testing.
META_PAGE_ID=

# ---------------------------------------------------------------------------
# ElevenLabs — voice cloning
# ---------------------------------------------------------------------------
# Get a key at https://elevenlabs.io/docs/api-reference
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# HeyGen — avatar video
# ---------------------------------------------------------------------------
# Get a key at https://www.heygen.com/api (paid plan required for API access)
HEYGEN_API_KEY=

# Optional. Defaults to Wayne_20240711.
HEYGEN_AVATAR_ID=
